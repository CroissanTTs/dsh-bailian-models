{
  "name": "dsh-bailian-models",
  "version": "1.5.0",
  "description": "Alibaba Bailian (DashScope) model catalog preset + auto-adapter for DeepSeek Harness — reasoning effort levels, thinking budgets, context windows, auto-adaptation of existing Bailian routes, a configurable context ceiling",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bailian",
    "dashscope",
    "qwen",
    "alibaba",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CroissanTTs/dsh-bailian-models.git"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src/",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "scripts": {
    "build": "node scripts/build-catalog.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/validate.mjs && node scripts/test-autoadapt.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.5-rc.1",
    "js-yaml": "^4.1.0"
  }
}
